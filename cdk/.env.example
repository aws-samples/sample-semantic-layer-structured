# ============================================================================
# Snowflake Athena connector — local deploy configuration
#
# Copy to `cdk/.env` and fill in. `cdk/.env` is gitignored; NEVER commit it.
#
#   cp cdk/.env.example cdk/.env
#
# Two halves, handled differently:
#
#   NON-SECRET (account/warehouse/database/role/secret-name)
#     Read by `cdk synth`/`cdk deploy`. May also be passed as `-c key=value`,
#     which takes PRECEDENCE over this file.
#
#   SECRET (user/private key/passphrase/password)
#     Read ONLY by `npm run sync:snowflake-secret`, which writes them straight to
#     Secrets Manager. They are never read during synth and never appear in a
#     CloudFormation template.
#
# Full deploy:
#   cd cdk
#   npm run deploy:snowflake        # cdk deploy + secret sync, in that order
#
# See cdk/README.md for the full setup, including the manual Snowflake-side
# `ALTER USER … SET RSA_PUBLIC_KEY` step, which CDK cannot perform.
#
# SYNTAX TRAP: never put a trailing comment on a value line. The parser splits on
# the FIRST `=` and keeps the remainder verbatim (env-config.ts: `indexOf('=')`
# then `slice(eq + 1).trim()`); a `#` is only treated as a comment when it is the
# line's first non-space character. So
#     SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=hunter2  # my passphrase
# yields the 24-character value "hunter2  # my passphrase", not "hunter2", and the
# failure surfaces far away as an opaque Snowflake `390144 … JWT token is invalid`.
# Put comments on their own line. Values are single-line only.
# ============================================================================

# ----------------------------------------------------------------------------
# Non-secret identifiers
#
# The Snowflake connector is ON BY DEFAULT (`enableSnowflakeConnector: true` in
# cdk/cdk.json), so the two REQUIRED keys below are required for EVERY deploy —
# `cdk synth`/`deploy` throws "enableSnowflakeConnector is on but snowflakeAccount /
# snowflakeWarehouse context is not set" until they are filled in. If you do not
# have a Snowflake account, deploy with `-c enableSnowflakeConnector=false`.
# ----------------------------------------------------------------------------

# Snowflake account identifier (e.g. `myorg-myacct`). REQUIRED when the
# connector is enabled — there is no default; the deploy fails loudly without it.
SNOWFLAKE_ACCOUNT=

# Virtual warehouse used to run federated queries. REQUIRED — no default.
SNOWFLAKE_WAREHOUSE=

# Database the connector reads. Optional; defaults to FHIR_DB.
SNOWFLAKE_DATABASE=FHIR_DB

# Comma-separated databases to expose. Each one gets its own connector Lambda and
# its own `snowflake_<db>` Athena catalog, because a connector's connection string
# pins exactly one `db=`. They share the execution role, spill bucket and secret.
#
# Use this INSTEAD OF SNOWFLAKE_DATABASE, not alongside it — setting both is a
# hard error rather than a precedence rule, since silently preferring one would
# deploy a catalog set nobody asked for. Works for one database as well as many.
# SNOWFLAKE_DATABASES=FHIR_DB,CLINICAL_CSV

# Role the connector assumes. Optional; defaults to ATHENA_CONNECTOR_ROLE.
SNOWFLAKE_ROLE=ATHENA_CONNECTOR_ROLE

# Secrets Manager secret name. Optional; defaults to the value below. The CDK
# stack creates a secret with this name; the sync script writes its value.
SNOWFLAKE_SECRET_NAME=semantic-layer/snowflake/connector

# ----------------------------------------------------------------------------
# Credentials — used by `npm run sync:snowflake-secret` only
#
# Pick EXACTLY ONE auth mode. Setting both (or neither) is an error: guessing
# would deploy a credential you did not intend and surface later as an opaque
# auth failure in the connector's CloudWatch logs.
# ----------------------------------------------------------------------------

# Snowflake user for the connector. REQUIRED for both auth modes.
SNOWFLAKE_USER=ATHENA_CONNECTOR

# --- Mode 1: key-pair auth (preferred) --------------------------------------
# Full PEM private key. Wrap in DOUBLE quotes and use \n for line breaks:
#   SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg…\n-----END PRIVATE KEY-----"
# The matching PUBLIC key must already be registered in Snowflake:
#   ALTER USER ATHENA_CONNECTOR SET RSA_PUBLIC_KEY='<body, no BEGIN/END, no newlines>';
SNOWFLAKE_PRIVATE_KEY=

# Passphrase, only if the private key is encrypted. Leave EMPTY for an
# unencrypted key — an empty value is treated as unset, because the connector
# reads a blank passphrase as a real one and fails to decrypt.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Mode 2: password auth (fallback) ---------------------------------------
# Use INSTEAD of SNOWFLAKE_PRIVATE_KEY above, not alongside it.
# SNOWFLAKE_PASSWORD=
